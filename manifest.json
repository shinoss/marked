{
  "manifest_version": 3,
  "name": "Marked — Bookmark Manager",
  "version": "1.1.0",
  "description": "An independent, local bookmark library. Start with a one-time Firefox snapshot, then organize separately.",
  "permissions": ["bookmarks", "storage", "unlimitedStorage", "menus", "activeTab"],
  "action": { "default_title": "Open Marked", "default_icon": "icons/marked.svg" },
  "icons": { "48": "icons/marked.svg", "96": "icons/marked.svg" },
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "marked@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
