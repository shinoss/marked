{
  "name": "marked-firefox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint:extension": "web-ext lint --source-dir . --ignore-files 'node_modules/**' 'tests/**' 'package*.json' 'README.md' 'web-ext-artifacts/**'",
    "build": "web-ext build --source-dir . --overwrite-dest --ignore-files 'node_modules/**' 'tests/**' 'package*.json' 'README.md' 'web-ext-artifacts/**'"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "web-ext": "^10.7.0"
  }
}
