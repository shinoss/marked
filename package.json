{
  "name": "marked",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "bundle": "node scripts/bundle.js",
    "build:chrome": "node scripts/package.js chrome",
    "build:firefox": "node scripts/package.js firefox",
    "build": "npm run bundle && node scripts/package.js chrome firefox",
    "build-for-amo": "npm run bundle && node scripts/package.js firefox",
    "build:source": "npm run bundle && node scripts/source.js",
    "lint:extension": "npm run build:firefox && web-ext lint --source-dir dist/firefox"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@mozilla/readability": "0.6.0"
  }
}
